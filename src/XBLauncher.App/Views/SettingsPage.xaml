<UserControl x:Class="XBLauncher.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Profil" Style="{StaticResource H2}" Margin="0,0,0,10" />
                <TextBlock Text="Name" Style="{StaticResource MutedText}" FontSize="11" />
                <TextBox x:Name="NameBox" Margin="0,2,0,10" />
                <TextBlock Text="Maximaler RAM (MB)" Style="{StaticResource MutedText}" FontSize="11" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                    <Slider x:Name="RamSlider" Minimum="1024" Maximum="4096" Value="3072" Width="320" TickFrequency="512" IsSnapToTickEnabled="True" />
                    <TextBlock x:Name="RamLabel" Text="3072 MB" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Spielordner" Style="{StaticResource MutedText}" FontSize="11" />
                <TextBlock x:Name="GameDirText" Margin="0,2,0,10" />
                <Button Content="Speichern" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="Save_Click" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Installierte Inhalte" Style="{StaticResource H2}" Margin="0,0,0,10" />
                <TextBlock x:Name="ContentSummary" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                <Button Content="Ordner öffnen" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenFolder_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
