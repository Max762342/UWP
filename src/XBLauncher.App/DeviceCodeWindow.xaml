<Window x:Class="XBLauncher.App.DeviceCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Microsoft-Anmeldung" Width="520" Height="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="Bei Microsoft anmelden" Style="{StaticResource H1}" FontSize="22" />
        <TextBlock Text="Öffne die folgende Adresse auf deinem Handy oder PC und gib den Code ein:"
                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,16" />

        <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceAltBrush}">
            <StackPanel>
                <TextBlock x:Name="UrlText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="CodeText" FontSize="42" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" Margin="0,16,0,8" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusLabel" Text="Warte auf Anmeldung..." Style="{StaticResource MutedText}"
                   HorizontalAlignment="Center" Margin="0,16,0,0" />
    </StackPanel>
</Window>
