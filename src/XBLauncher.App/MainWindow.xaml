<Window x:Class="XBLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XB-Launcher" Width="1180" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}">
            <DockPanel Margin="0,16,0,16">
                <StackPanel DockPanel.Dock="Top" Margin="16,0,16,16">
                    <TextBlock Text="XB-Launcher" Style="{StaticResource H2}" />
                    <TextBlock Text="Minecraft Java für Xbox" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,0">
                    <TextBlock x:Name="UserText" Text="Nicht angemeldet" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" />
                    <Button x:Name="SignInButton" Content="Microsoft-Anmeldung" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" Click="SignInButton_Click" />
                    <Button x:Name="SignOutButton" Content="Abmelden" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Click="SignOutButton_Click" Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Margin="16,0">
                    <Button x:Name="NavPlay" Content="▶  Spielen" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="NavPlay_Click" />
                    <Button x:Name="NavMods" Content="🧩  Mods Hub" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="NavMods_Click" />
                    <Button x:Name="NavShaders" Content="🎨  Shader Hub" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="NavShaders_Click" />
                    <Button x:Name="NavPacks" Content="📦  Packs Hub" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="NavPacks_Click" />
                    <Button x:Name="NavSettings" Content="⚙  Einstellungen" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Click="NavSettings_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Page header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="PageTitle" Text="Spielen" Style="{StaticResource H1}" />
                <TextBlock x:Name="PageSubtitle" Text="Wähle Version und Profil" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Page host -->
            <ContentControl x:Name="PageHost" Grid.Row="1" />

            <!-- Status bar -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="Bereit." Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="StatusProgress" Grid.Column="1" Value="0" Maximum="100" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
