<Page
    x:Class="XBLauncher.UwpApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Modern Glassmorphism Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarGradient}">
            <Grid>
                <!-- Glassmorphism Overlay -->
                <Border Background="#11FFFFFF" />
                
                <!-- Content -->
                <StackPanel Margin="24,32,24,24">
                    <!-- Logo -->
                    <Border Width="80" Height="80" CornerRadius="20" HorizontalAlignment="Center" Margin="0,0,0,16"
                            Background="{StaticResource AccentGradient}">
                        <Image Source="ms-appx:///Assets/GameLogo.png" Width="64" Height="64"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    
                    <TextBlock Text="XB-Launcher" Style="{StaticResource H2}" HorizontalAlignment="Center" />
                    <TextBlock Text="Minecraft Java für Xbox" Style="{StaticResource CaptionText}" 
                               HorizontalAlignment="Center" Margin="0,4,0,32" />

                    <!-- Navigation -->
                    <Button x:Name="NavPlay" Content="▶  Spielen" Style="{StaticResource NavButton}" Click="NavPlay_Click" Margin="0,0,0,8" />
                    <Button x:Name="NavMods" Content="🧩  Mods Hub" Style="{StaticResource NavButton}" Click="NavMods_Click" Margin="0,0,0,8" />
                    <Button x:Name="NavShaders" Content="🎨  Shader Hub" Style="{StaticResource NavButton}" Click="NavShaders_Click" Margin="0,0,0,8" />
                    <Button x:Name="NavPacks" Content="📦  Packs Hub" Style="{StaticResource NavButton}" Click="NavPacks_Click" Margin="0,0,0,8" />
                    <Button x:Name="NavSettings" Content="⚙  Einstellungen" Style="{StaticResource NavButton}" Click="NavSettings_Click" />

                    <!-- Version -->
                    <Border Background="#22FFFFFF" CornerRadius="12" Padding="12" Margin="0,32,0,0">
                        <StackPanel>
                            <TextBlock Text="XB-Launcher v1.0" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
                            <TextBlock Text="Build 2026.10" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="32,32,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Page Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock x:Name="PageTitle" Text="Spielen" Style="{StaticResource H1}" />
                <TextBlock x:Name="PageSubtitle" Text="Wähle Minecraft-Version und Mod-Loader" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
            </StackPanel>

            <!-- Page Host -->
            <Frame x:Name="PageFrame" Grid.Row="1" />

            <!-- Modern Status Bar -->
            <Border Grid.Row="2" Background="{StaticResource GlassBrush}" 
                    BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="20,16" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    
                    <!-- Status -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Width="8" Height="8" Margin="0,0,12,0" />
                        <TextBlock x:Name="StatusText" Text="Bereit." Style="{StaticResource BodyText}" 
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    
                    <!-- Progress -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <ProgressBar x:Name="StatusProgress" Value="0" Maximum="100" Height="6" CornerRadius="3" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>