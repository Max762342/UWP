<Page
    x:Class="XBLauncher.UwpApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}">
            <StackPanel Margin="20,24,20,24">
                <TextBlock Text="XB-Launcher" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4" />
                <TextBlock Text="Minecraft Java für Xbox" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,24" />

                <Button x:Name="NavPlay" Content="▶  Spielen" Style="{StaticResource NavButton}" Click="NavPlay_Click" Margin="0,0,0,8" />
                <Button x:Name="NavMods" Content="🧩  Mods Hub" Style="{StaticResource NavButton}" Click="NavMods_Click" Margin="0,0,0,8" />
                <Button x:Name="NavShaders" Content="🎨  Shader Hub" Style="{StaticResource NavButton}" Click="NavShaders_Click" Margin="0,0,0,8" />
                <Button x:Name="NavPacks" Content="📦  Packs Hub" Style="{StaticResource NavButton}" Click="NavPacks_Click" Margin="0,0,0,8" />
                <Button x:Name="NavSettings" Content="⚙  Einstellungen" Style="{StaticResource NavButton}" Click="NavSettings_Click" />

                <StackPanel VerticalAlignment="Bottom" Margin="0,40,0,0">
                    <TextBlock Text="XB-Launcher v1.0" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Page Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="PageTitle" Text="Spielen" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="PageSubtitle" Text="Wähle Minecraft-Version und Mod-Loader" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Page Host -->
            <Frame x:Name="PageFrame" Grid.Row="1" />

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="Bereit." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <ProgressBar x:Name="StatusProgress" Grid.Column="1" Value="0" Maximum="100" Height="8" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>