<Page
    x:Class="XBLauncher.UwpApp.Views.PlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Profile & Version Selector -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Profil" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                    <ComboBox x:Name="ProfileBox" SelectionChanged="ProfileBox_SelectionChanged" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Version + Loader" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                    <ComboBox x:Name="TargetBox" SelectionChanged="TargetBox_SelectionChanged" />
                </StackPanel>
                <Button Grid.Column="2" Content="＋ Profil" Style="{StaticResource SecondaryButton}" Click="AddProfile_Click" VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Text="Verfügbare Versionen" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,8" />

        <!-- Version Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="VersionList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,0,10,10" Width="200" Tapped="Version_Tapped">
                            <StackPanel>
                                <TextBlock Text="{Binding MinecraftVersion}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding Loader}" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding LoaderVersion}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Play Button -->
        <Button Grid.Row="3" x:Name="PlayButton" Content="▶  SPIELEN" Style="{StaticResource PrimaryButton}"
                FontSize="22" Padding="32,18" HorizontalAlignment="Stretch" Margin="0,12,0,0" Click="PlayButton_Click" />
    </Grid>
</Page>