<Page
    x:Class="XBLauncher.UwpApp.Views.PlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Profile & Version Selector -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Profil" Style="{StaticResource CaptionText}" Margin="0,0,0,8" />
                    <ComboBox x:Name="ProfileBox" SelectionChanged="ProfileBox_SelectionChanged" />
                </StackPanel>
                
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="Version + Loader" Style="{StaticResource CaptionText}" Margin="0,0,0,8" />
                    <ComboBox x:Name="TargetBox" SelectionChanged="TargetBox_SelectionChanged" />
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="＋ Profil" Style="{StaticResource SecondaryButton}" Click="AddProfile_Click" Margin="0,0,12,0" />
                    <Button x:Name="LoginButton" Content="Anmelden" Style="{StaticResource PrimaryButton}" Click="Login_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Section Header -->
        <StackPanel Grid.Row="1" Margin="0,8,0,16">
            <TextBlock Text="Verfügbare Versionen" Style="{StaticResource H2}" />
            <TextBlock Text="Wähle deine Minecraft-Version und den Mod-Loader" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Version Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="VersionList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardHover}" Margin="0,0,16,16" Width="220" Tapped="Version_Tapped">
                            <StackPanel>
                                <!-- Version Number -->
                                <TextBlock Text="{Binding MinecraftVersion}" Style="{StaticResource H2}" />
                                
                                <!-- Loader Badge -->
                                <Border Background="#2210B981" CornerRadius="6" Padding="8,4" 
                                        HorizontalAlignment="Left" Margin="0,12,0,8">
                                    <TextBlock Text="{Binding Loader}" FontSize="12" FontWeight="SemiBold" 
                                               Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                
                                <!-- Loader Version -->
                                <TextBlock Text="{Binding LoaderVersion}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Modern Play Button -->
        <Button Grid.Row="3" x:Name="PlayButton" Style="{StaticResource PrimaryButton}"
                FontSize="20" Padding="40,20" HorizontalAlignment="Stretch" Margin="0,20,0,0" Click="PlayButton_Click">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="▶" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Text="SPIELEN" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </Grid>
</Page>