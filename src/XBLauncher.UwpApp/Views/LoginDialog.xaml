<Page
    x:Class="XBLauncher.UwpApp.Views.LoginDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BgBrush}">

    <!-- Modern Login Screen with Gradient Background -->
    <Grid>
        <!-- Gradient Background Overlay -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF0A0E14" Offset="0" />
                    <GradientStop Color="#FF0F172A" Offset="0.5" />
                    <GradientStop Color="#FF1E293B" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <!-- Logo with Glow -->
                <Border Width="140" Height="140" CornerRadius="70" HorizontalAlignment="Center" Margin="0,0,0,24"
                        Background="{StaticResource AccentGradient}">
                    <Image x:Name="LogoImage" Source="ms-appx:///Assets/GameLogo.png" Width="120" Height="120"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Title -->
                <TextBlock Text="XB-Launcher" Style="{StaticResource H1}" HorizontalAlignment="Center" />
                <TextBlock Text="Minecraft: Java Edition für Xbox" Style="{StaticResource MutedText}" 
                           HorizontalAlignment="Center" Margin="0,8,0,32" />

                <!-- Login Card -->
                <Border Style="{StaticResource Card}" x:Name="CodeCard" Visibility="Collapsed">
                    <StackPanel>
                        <!-- QR Code Section -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- QR Code -->
                            <Border Grid.Column="0" Background="White" Padding="12" CornerRadius="16" Margin="0,0,24,0">
                                <Image x:Name="QrImage" Width="200" Height="200" Stretch="Fill" />
                            </Border>

                            <!-- Instructions -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Scanne den QR-Code" Style="{StaticResource H3}" Margin="0,0,0,8" />
                                <TextBlock Text="oder öffne auf dem Handy/PC:" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                                
                                <!-- URL -->
                                <Border Background="#2210B981" CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
                                    <TextBlock x:Name="UriText" FontSize="13" Foreground="{StaticResource AccentBrush}" 
                                               TextWrapping="Wrap" FontFamily="Consolas" />
                                </Border>

                                <!-- User Code -->
                                <TextBlock Text="Dein Code:" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                                <Border Background="#3310B981" CornerRadius="12" Padding="16">
                                    <TextBlock x:Name="UserCodeText" FontSize="42" FontWeight="Bold" 
                                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Progress Section -->
                <StackPanel Margin="0,32,0,0">
                    <!-- Modern Progress Bar -->
                    <Grid>
                        <Border Background="#22FFFFFF" CornerRadius="4" Height="8" />
                        <ProgressBar x:Name="LoginProgress" IsIndeterminate="True" Height="8" CornerRadius="4" />
                    </Grid>
                    
                    <!-- Status -->
                    <Border Background="#22FFFFFF" CornerRadius="12" Padding="16,12" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="StatusText" Text="Bereit." Style="{StaticResource BodyText}" 
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Cancel Button -->
                <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" 
                        HorizontalAlignment="Center" Margin="0,24,0,0" Click="Cancel_Click" />

                <!-- Footer -->
                <StackPanel Margin="0,40,0,0" HorizontalAlignment="Center">
                    <TextBlock Text="Sicherer Microsoft-Login" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
                    <TextBlock Text="✓ Ownership verifiziert  ✓ Kein Crack  ✓ Offizielle APIs" 
                               Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>