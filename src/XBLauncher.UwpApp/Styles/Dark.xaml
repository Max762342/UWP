<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <SolidColorBrush x:Key="BgBrush" Color="#FF0E1116" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF161B22" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF1F2630" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF3DDC84" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#FF2BB673" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFE6EDF3" />
    <SolidColorBrush x:Key="MutedBrush" Color="#FF8B949E" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFF85149" />

    <!-- Nav Button Style -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Primary Button -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="#FF0E1116" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Secondary Button -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Card Style -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="#FF30363D" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- ComboBox -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="#FF30363D" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- ProgressBar -->
    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

</ResourceDictionary>